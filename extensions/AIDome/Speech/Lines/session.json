    {
      "id": "start.plain",
      "act": "SessionStart",
      "when": ["!punishment", "sessions>=1"],
      "variants": [
        "Here we go, [name].",
        "Hands ready. We're starting.",
        "Good. You're here. Let's begin.",
        "Settle in. I'm in charge now.",
        "Let's see what you've got for me tonight.",
        "Get comfortable. You won't be for long."
