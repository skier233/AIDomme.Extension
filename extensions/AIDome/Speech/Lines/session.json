    {
      "id": "start.first-ever",
      "act": "SessionStart",
      "cooldown": "Once",
      "when": ["sessions<1", "!punishment"],
      "variants": ["So this is the first time. Listen carefully and do exactly what I say, and we'll get along fine."]
