    { "id": "retaliation.ruined", "act": "Retaliation", "when": ["#reason:RuinedOrgasm"], "variants": ["You ruined it without permission? Then you don't even get the pleasure of it. Keep going.", "Ruined, and not by me. That's going to cost you."] },
    { "id": "retaliation.disobedience", "act": "Retaliation", "when": ["#reason:Disobedience"], "variants": ["You disobeyed me. You know what happens now.", "Thank you for telling me. Now you pay for it.", "I don't tolerate disobedience. Watch what happens."] },

    // ── Deals ──
    { "id": "offer.orgasm", "act": "OfferMade", "when": ["#buys:orgasm"], "variants": ["No. Not for free. [offer]", "Not yet... unless you pay for it. [offer]", "You want it that badly? Then pay. [offer]", "Hmm. Maybe. [offer]"] },
    { "id": "offer.orgasm.playful", "act": "OfferMade", "when": ["#buys:orgasm", "mood=Playful|Teasing"], "variants": ["Let's make a deal. [offer]", "I'm feeling generous. Sort of. [offer]"] },
    { "id": "offer.rest", "act": "OfferMade", "when": ["#buys:rest"], "variants": ["A break costs something. [offer]", "Tired already? Fine, but it isn't free. [offer]", "You can have one. For a price. [offer]"] },
