    { "id": "offer.declined.orgasm", "act": "OfferDeclined", "when": ["#buys:Orgasm"], "variants": ["Your loss.", "Then you don't cum. Simple.", "Suit yourself."] },
    { "id": "offer.declined.rest", "act": "OfferDeclined", "when": ["#buys:Rest"], "variants": ["Then keep going.", "No break for you, then."] },
    { "id": "offer.declined.mercy", "act": "OfferDeclined", "when": ["#buys:Mercy"], "variants": ["Your choice. Take your punishment, then.", "Brave. Or stupid. Take your punishment."] },
    { "id": "offer.expired.mercy", "act": "OfferExpired", "when": ["#mercy"], "variants": ["Too slow. Take your punishment.", "You hesitated. The punishment stands."] },
    { "id": "price.progress", "act": "PriceProgress", "variants": ["[Left] more.", "Keep paying. [Left] left.", "Good. [Left] to go."] },
    { "id": "price.paid.orgasm", "act": "PricePaid", "when": ["#buys:Orgasm"], "variants": ["Paid in full.", "There. You earned it.", "Good. That's what it cost."] },
    { "id": "price.paid.rest", "act": "PricePaid", "when": ["#buys:Rest"], "variants": ["Paid. Now you can rest.", "Good. Take your break."] },
    { "id": "mercy", "act": "MercyGranted", "variants": ["You're off the hook. This time.", "Fine. Punishment cancelled. You'll pay the other way."] }
