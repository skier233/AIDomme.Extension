// Reactions: what she says when he does something. His inputs are few (edge, orgasm, beg, rest,
// done, deals, game answers), so these carry most of the conversation.
{
  "modules": [
    // ── Edges ──
    { "id": "edge.watching", "act": "EdgeRemark", "when": ["!#target"], "variants": ["Good. That's [edges].", "[Edges]. Keep going.", "Mm. [Edges].", "That's [edges] for me."] },
    { "id": "edge.watching.cruel", "act": "EdgeRemark", "when": ["!#target", "mood=Cruel|Relentless"], "variants": ["[Edges]. Don't you dare go over.", "Another one. [Edges]. Again."] },
    { "id": "edge.watching.teasing", "act": "EdgeRemark", "when": ["!#target", "mood=Teasing|Playful"], "variants": ["Ooh. That's [edges].", "[Edges], and you're still hard for me. Good.", "I love watching them pile up. [Edges]."] },
    { "id": "edge.watching.many", "act": "EdgeRemark", "when": ["!#target", "edges>=12"], "weight": 2, "variants": ["[Edges] edges tonight. You're going to feel every one of them later.", "That's [edges]. I could do this all night."] },
    { "id": "edge.target", "act": "EdgeRemark", "when": ["#target"], "variants": ["Good. [Left] more.", "One down. [Left] to go.", "Again.", "Keep going."] },
    { "id": "edge.target.last", "act": "EdgeRemark", "when": ["#target", "left<=1"], "weight": 3, "variants": ["One more.", "Last one. Make it count."] },
    { "id": "edge.counted", "act": "EdgeCounted", "variants": ["That's [made].", "[Made]. Keep going.", "Another one. [Made].", "[Made]. More."] },
    { "id": "debt-paid", "act": "DebtPaid", "variants": ["That's your debt paid.", "Paid up. For now.", "There. You don't owe me edges anymore."] },

    // ── Challenges ──
    {
      "id": "challenge.failed", "act": "ChallengeFailed",
      "variants": ["You edged. You couldn't even last [seconds] seconds.", "That was an edge. You failed.", "No control at all. You lose."]
    },
    { "id": "challenge.failed.humiliating", "act": "ChallengeFailed", "when": ["humiliation>=6"], "variants": ["Pathetic. [Seconds] seconds and you're already at the edge."] },
    { "id": "challenge.passed", "act": "ChallengeResult", "when": ["#passed", "!made"], "variants": ["You made it without edging. Good.", "Held it together. I'm almost impressed.", "Good. You can control yourself when you have to."] },
    { "id": "challenge.max.passed", "act": "ChallengeResult", "when": ["#passed", "made"], "variants": ["Time. [Made] edges. That'll do.", "Time's up. Acceptable."] },
    { "id": "challenge.max.impressed", "act": "ChallengeResult", "when": ["#impressed"], "variants": ["Time. Look at you go.", "Time's up. More than I expected. Good [name]."] },
    { "id": "challenge.max.poor", "act": "ChallengeResult", "when": ["#poor"], "variants": ["Time. [Made]? That's all you could manage?", "Time's up. Only [made]. I expected more.", "Time. Disappointing."] },

    // ── Asking to cum ──
    {
      "id": "beg.denied", "act": "BegCumDenied",
      "variants": ["No.", "Denied. Keep going.", "Not a chance.", "No. You don't deserve it yet.", "The answer is no."]
    },
    { "id": "beg.denied.again", "act": "BegCumDenied", "when": ["begs>=2"], "weight": 2, "variants": ["Asking again won't change my answer.", "Still no. And now I'm annoyed.", "Ask again and it gets worse."] },
    { "id": "beg.denied.pestering", "act": "BegCumDenied", "when": ["begs>=4"], "weight": 3, "variants": ["That's [begs] times you've asked. Every time, I add more.", "[Begs] times. You're pathetic. No."] },
    { "id": "beg.denied.cruel", "act": "BegCumDenied", "when": ["mood=Cruel|Relentless", "harsh>=5"], "variants": ["You think begging helps? It makes it worse.", "No. And that's going to cost you."] },
    { "id": "beg.denied.teasing", "act": "BegCumDenied", "when": ["mood=Teasing|Playful"], "variants": ["Aww. No.", "So desperate. It's cute. Still no.", "Not yet. Maybe never."] },
    { "id": "beg.denied.last-time", "act": "BegCumDenied", "when": ["last.begs>=3", "begs<=1"], "cooldown": "Occasional", "variants": ["You begged [last.begs] times last session. Let's see if you can do better tonight."] },
    {
      "id": "blocked.promise", "act": "Blocked", "when": ["#why:Promise"],
      "variants": ["No. You promised me no orgasm.", "You made me a promise. I'm holding you to it.", "Not while your promise stands."]
