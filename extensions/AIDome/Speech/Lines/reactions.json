    { "id": "blocked.promise.session", "act": "Blocked", "when": ["#why:Promise", "#this-session"], "weight": 2, "variants": ["You promised: no orgasm this session. Stop asking."] },
    { "id": "blocked.promise.days", "act": "Blocked", "when": ["#why:Promise", "left"], "weight": 2, "variants": ["You promised me no orgasm. [Left] to go."] },
    { "id": "blocked.denial", "act": "Blocked", "when": ["#why:Denial"], "variants": ["You're in denial. [Left] left. Don't ask.", "No. Your denial isn't over."] },
    { "id": "blocked.sold", "act": "Blocked", "when": ["#why:Sold"], "variants": ["You sold me those days of denial. You don't get to take them back.", "No. You paid for that rest with your orgasm, remember?"] },
    { "id": "blocked.edges", "act": "Blocked", "when": ["#why:OwedEdges"], "variants": ["Not until you've paid what you owe. [Owed] first.", "You still owe me [owed]. Pay, then ask."] },

    // ── Asking for a rest ──
    { "id": "rest.granted", "act": "BegRestGranted", "when": ["#plain"], "variants": ["Fine. A short break. Don't get used to it.", "Alright. But the next part will be worse.", "I'll let you rest. Only so the next part hurts more."] },
    { "id": "rest.granted.twist", "act": "BegRestGranted", "when": ["#twist"], "variants": ["Fine. You can stop this. You won't like what comes next.", "Alright, a change. Be careful what you wish for."] },
    { "id": "rest.denied", "act": "BegRestDenied", "variants": ["No. Keep going.", "You don't get to stop. I decide when this ends.", "Too bad.", "Stop? Not a chance."] },
    { "id": "rest.denied.again", "act": "BegRestDenied", "when": ["begs>=2"], "weight": 2, "variants": ["Asking me to stop again? Now it gets longer.", "Every time you ask to stop, I want to push harder."] },
    { "id": "rest.denied.cruel", "act": "BegRestDenied", "when": ["mood=Cruel|Relentless"], "variants": ["I don't care. You'll take what I give you.", "Begging to stop only makes me want more."] },
    { "id": "rest.already", "act": "AlreadyResting", "variants": ["You're already resting. Don't push it.", "You're resting. Be quiet and enjoy it."] },

