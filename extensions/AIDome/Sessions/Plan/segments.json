  // Tags a plan must include when the session asks for it (keys: punishment, torturous, teasing, intense, mean).
  "requires": {
    "punishment": ["torture"],
    "torturous": ["torture"],
    "teasing": ["tease"]
  },
  // How her mood leans on segment tags when she plans (a multiplier, scaled by how strongly she feels it).
  "moodLenses": {
    "Cruel": { "torture": 1.7, "tease": 0.7, "rest": 0.6, "punish": 1.4 },
    "Relentless": { "edging": 1.5, "intense": 1.4, "rest": 0.4, "slow": 0.6 },
    "Edgy": { "edging": 1.6, "hold": 1.3, "tease": 0.8 },
    "Teasing": { "tease": 1.7, "slow": 1.5, "psych": 1.5, "torture": 0.6 },
    "Playful": { "game": 1.9, "challenge": 1.5, "surprise": 1.4, "torture": 0.7 },
    "Neutral": { "stroking": 1.2 }
  }
