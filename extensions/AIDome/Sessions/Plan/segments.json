// The segment catalogue: every goal she can pursue for a stretch of a session.
// The plan engine reads only these properties; adding a segment type is adding an entry here.
//   tags        what kind of thing it is (other types refer to tags in follows/followUp)
//   intensity   0-10, for the escalation curve across the session
//   needs       what she must decide for it: pacing, edges, methods, games
//   share       [min, max] share of the session's points budget
//   steps       [min, max] steps
//   position    weights for start / middle / late in the session
//   follows     multiplier when the previous segment has a tag
//   followUp    tags the next segment must have
//   onRestBeg   what she does when he begs for a rest during it
//   persona     minimum persona dials for her to use it
//   step        the shape of its steps (ranges are [min, max])
{
  "segments": [
    {
      "id": "slow-build",
      "name": "Slow build",
      "goal": "Warm him up slowly with teasing touches, without letting him edge.",
      "tags": ["setup", "tease"],
      "intensity": 2,
      "needs": ["pacing"],
      "share": [0.06, 0.14],
      "steps": [1, 4],
      "position": { "start": 2.2, "middle": 0.6, "late": 0.3 },
      "follows": { "rest": 1.4, "torture": 1.3, "tease": 0.4 },
      "step": { "kind": "Timed", "speed": [1, 3], "seconds": [40, 90], "method": { "policy": "rotate", "prefer": "tease", "ceiling": -1 } }
    },
    {
      "id": "stroke-steady",
      "name": "Steady stroking",
      "goal": "Plain, steady stroking on a good grip: keep him hard and building.",
      "tags": ["stroking"],
      "intensity": 4,
      "needs": ["pacing"],
      "share": [0.06, 0.16],
      "steps": [1, 4],
      "repeatable": true,
      "position": { "start": 1.3, "middle": 1.0, "late": 0.7 },
      "follows": { "setup": 1.5, "rest": 1.5, "stroking": 0.5 },
      "step": { "kind": "Timed", "speed": [3, 6], "seconds": [45, 120], "method": { "policy": "same", "prefer": "basic", "ceiling": 0 } }
    },
    {
      "id": "edge-steady",
      "name": "Edging",
      "goal": "Bring him to the edge and back, again and again, on grips that get him there.",
      "tags": ["edging"],
      "intensity": 5,
      "needs": ["edges"],
      "share": [0.08, 0.18],
      "steps": [1, 5],
      "repeatable": true,
      "position": { "start": 0.8, "middle": 1.3, "late": 1.1 },
      "follows": { "setup": 1.8, "stroking": 1.8, "rest": 1.2, "edging": 0.6 },
      "step": { "kind": "Edges", "speed": [4, 7], "count": [1, 3], "hold": [5, 20], "holdChance": 0.35, "method": { "policy": "rotate", "prefer": "closeness", "ceiling": 1 } }
    },
    {
      "id": "edge-ladder",
      "name": "Edge ladder",
      "goal": "One edge at a time, each one faster than the last.",
      "tags": ["edging", "setup"],
      "intensity": 5,
      "needs": ["edges", "pacing"],
      "share": [0.08, 0.16],
      "steps": [3, 5],
      "position": { "start": 0.9, "middle": 1.2, "late": 0.8 },
      "follows": { "stroking": 1.5, "tease": 1.5, "rest": 1.2, "edging": 0.5 },
      "step": { "kind": "Edges", "speed": [3, 9], "rise": true, "count": [1, 1], "method": { "policy": "same", "prefer": "closeness", "ceiling": 1 } }
    },
    {
      "id": "rapid-fire",
