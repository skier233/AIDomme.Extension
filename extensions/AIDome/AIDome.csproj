<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AIDome</AssemblyName>
    <RootNamespace>AIDome</RootNamespace>
  </PropertyGroup>

  <!-- Cove host contracts (Cove.Sdk, Cove.Core, Cove.Data) are wired compile-only by Directory.Build.targets. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Literal SQL migrations, loaded by GuidedMigrations.Load. -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Sql\*.sql" LogicalName="AIDome.Sql.%(Filename).sql" />
  </ItemGroup>

  <!-- Her segment catalogue and line files: data, validated when first loaded and by the tests. -->
  <ItemGroup>
    <EmbeddedResource Include="Sessions\Plan\segments.json" LogicalName="AIDome.Plan.segments.json" />
    <EmbeddedResource Include="Speech\Lines\*.json" LogicalName="AIDome.Lines.%(Filename).json" />
  </ItemGroup>
</Project>
