// The segment catalogue.
//
// A segment is a few minutes with one purpose (ache, control, overwhelm, starve, cool). Most are
// improvised: she chooses the parameters from his state and the steerer makes the steps. Those
// entries ("written": false) only name the shapes that come out, for the debug view and for her
// lines. A written segment ("written": true) has a specific shape that is the point; its steps
// come from "step". Written aims are shapes across several segments.
//
//   purpose     what it makes him feel: ache, control, overwhelm, starve, cool
//   tags        what kind of thing it is, for her lines
//   needs       what she must decide for it: pacing, edges, methods, games
//   persona     minimum persona dials for her to use it
// Written segments only:
//   share       [min, max] share of the session's points budget
//   steps       [min, max] steps
//   fits        the aims (purposes) it may appear in; empty: any
//   weight      how often its turn comes up
//   step        the shape of its steps (ranges are [min, max])
{
  "segments": [
    // ── Shapes she improvises ──
    { "id": "slow-build", "name": "Slow build", "purpose": "ache", "tags": ["setup", "tease"],
      "goal": "Warm him up slowly on grips that feel good, kept under the edge." },
    { "id": "stroke-steady", "name": "Steady stroking", "purpose": "ache", "tags": ["stroking"],
      "goal": "Steady stroking on grips that get him close, kept just under the edge so the want builds." },
    { "id": "keep-under", "name": "Stay away from the edge", "purpose": "ache", "tags": ["stroking", "challenge"],
      "goal": "Keep stroking on a good grip and do not reach the edge. Getting there costs him." },
    { "id": "edge-fresh", "name": "Slow edges", "purpose": "ache", "tags": ["edging", "slow"],
      "goal": "One unhurried edge at a time, with long enough between them that each is a fresh climb." },
    { "id": "edge-steady", "name": "Edging", "purpose": "control", "tags": ["edging"],
      "goal": "To the edge and partly back, again and again; she decides how far he comes down." },
    { "id": "rapid-fire", "name": "Rapid-fire edges", "purpose": "control", "tags": ["edging", "intense", "payoff"],
      "goal": "Edge after edge with no time to come down." },
    { "id": "long-hold", "name": "Holding at the edge", "purpose": "control", "tags": ["edging", "hold", "payoff"],
      "goal": "Get to the edge and stay there, as long as she judges he can." },
    { "id": "torment", "name": "Torment", "purpose": "overwhelm", "tags": ["torture"],
      "goal": "Grips so much he is desperate to stop. He takes every second." },
    { "id": "hated-grip", "name": "The grip he hates", "purpose": "overwhelm", "tags": ["torture"],
      "goal": "The most torturous grip she is allowed, and she stays on it." },
    { "id": "punish", "name": "Punishment", "purpose": "overwhelm", "tags": ["torture", "punish"], "planned": false,
      "goal": "Make him pay for what he just did." },
    { "id": "tempo-crawl", "name": "Barely touching", "purpose": "starve", "tags": ["tease", "slow"],
      "goal": "The lightest touch at a crawl: enough to feel, nowhere near enough." },
    { "id": "tease-rest", "name": "Hands off", "purpose": "starve", "tags": ["rest", "tease", "psych"],
      "goal": "Hands off while she talks to him: nothing at all, and the ache does not fade." },
    { "id": "breather", "name": "Breather", "purpose": "cool", "tags": ["rest"],
      "goal": "A real, short rest so he can take more." },

    // ── Written segments ──
    {
      "id": "edge-ladder", "name": "Edge ladder", "purpose": "control", "written": true, "tags": ["edging", "setup"],
      "goal": "One edge at a time, each one faster than the last.",
      "needs": ["edges", "pacing"], "fits": ["ache", "control"], "share": [0.06, 0.12], "steps": [3, 5],
      "step": { "kind": "Edges", "speed": [3, 9], "rise": true, "count": [1, 1], "method": { "policy": "same", "prefer": "closeness", "ceiling": 1 } }
    },
    {
      "id": "countdown", "name": "Countdown", "purpose": "control", "written": true, "tags": ["edging", "countdown"],
      "goal": "A number of edges announced up front, counted down one by one.",
      "needs": ["edges", "pacing"], "fits": ["ache", "control"], "share": [0.06, 0.14], "steps": [3, 6],
      "step": { "kind": "Edges", "speed": [5, 8], "count": [1, 1], "method": { "policy": "rotate", "prefer": "closeness", "ceiling": 1 } }
    },
    {
      "id": "max-edges", "name": "As many as you can", "purpose": "control", "written": true, "tags": ["edging", "challenge", "intense"],
      "goal": "Give her as many edges as he can in the time, at her tempo.",
      "needs": ["pacing"], "fits": ["control"], "share": [0.05, 0.12], "steps": [1, 1],
      "step": { "kind": "MaxEdges", "speed": [6, 8], "seconds": [60, 150], "method": { "policy": "same", "prefer": "closeness", "ceiling": 1 } }
    },
    {
      "id": "no-edge", "name": "Don't you dare", "purpose": "control", "written": true, "tags": ["challenge", "intense"],
      "goal": "Stroke hard for a set time without reaching the edge. An edge fails it.",
      "needs": ["pacing"], "fits": ["ache", "control"], "share": [0.04, 0.1], "steps": [1, 2],
      "step": { "kind": "NoEdge", "speed": [7, 9], "seconds": [30, 75], "method": { "policy": "rotate", "prefer": "closeness", "ceiling": 1 } }
    },
    {
      "id": "hard-edge", "name": "Edge the hard way", "purpose": "overwhelm", "written": true, "tags": ["torture", "edging", "punish"],
      "goal": "Edge on an intense grip that barely gets him there. Slow, overwhelming, and he has to earn it.",
      "needs": ["edges", "pacing", "methods"], "fits": ["overwhelm", "control"], "share": [0.05, 0.12], "steps": [1, 2], "weight": 0.4,
      "persona": { "harsh": 4 },
      "step": { "kind": "Edges", "speed": [6, 9], "count": [1, 1], "reach": "hard", "method": { "policy": "hated", "prefer": "torture", "ceiling": 3 } }
    },
    {
      "id": "burst", "name": "Burst", "purpose": "ache", "written": true, "tags": ["intense", "surprise"],
      "goal": "Out of nowhere: full speed, very short, then stop.",
      "needs": ["pacing"], "fits": ["ache", "starve"], "share": [0.02, 0.05], "steps": [1, 2], "weight": 0.6,
      "step": { "kind": "Burst", "speed": [9, 10], "seconds": [10, 25], "method": { "policy": "rotate", "prefer": "any", "ceiling": 3 } }
    },
    {
      "id": "false-finish", "name": "False finish", "purpose": "starve", "written": true, "tags": ["psych", "tease"],
      "goal": "Let him think it's over, or that he's about to cum. Then more.",
      "needs": ["pacing"], "share": [0.01, 0.03], "steps": [1, 1], "weight": 0.5,
      "persona": { "manipulation": 4 },
      "step": { "kind": "Rest", "seconds": [10, 20] }
    },
    {
      "id": "game", "name": "A game", "purpose": "ache", "written": true, "tags": ["game"],
      "goal": "A game whose stakes come from what she is doing to him. She enjoys it more than he does.",
      "needs": ["games", "pacing"], "share": [0.03, 0.08], "steps": [1, 1], "weight": 1.6,
      "step": { "kind": "Game" }
    },
    {
      "id": "ending", "name": "The ending", "purpose": "cool", "written": true, "tags": ["ending"], "planned": false,
      "goal": "She decides how this ends.",
      "share": [0.01, 0.01], "steps": [1, 1],
      "step": { "kind": "Rest" }
    }
  ],

  // Written aims: a shape across several segments. "pattern" is the purposes of its segments in
  // order, repeated until the aim's share is spent. "chance" is how often she takes the shape when
  // an aim of its purpose begins; "event" marks one only an event brings on.
  "aims": [
    {
      "id": "back-and-forth", "name": "Back and forth", "purpose": "overwhelm", "pattern": ["overwhelm", "control"],
      "goal": "Torment, then straight into fast edges, then torment again: no way to settle into either.",
      "seconds": [50, 90], "needs": ["pacing", "edges", "methods"], "persona": { "harsh": 4 }, "chance": 0.3
    },
    {
      "id": "dread", "name": "Dread", "purpose": "overwhelm", "pattern": ["starve", "overwhelm"],
      "goal": "Hands off while she tells him what is coming, then it comes.",
      "seconds": [40, 90], "needs": ["pacing", "methods"], "persona": { "manipulation": 3, "talk": 3 }, "chance": 0.2
    },
    {
      "id": "mercy", "name": "Mercy with a catch", "purpose": "overwhelm", "pattern": ["cool", "control", "overwhelm"],
      "goal": "He begged, so he gets his break, and then edges instead, and then it carries on.",
      "seconds": [40, 80], "needs": ["pacing"], "event": "restbeg"
    }
  ],

  // Purposes a plan must include when the session asks for it (keys: punishment, torturous, teasing, intense, mean).
  "requires": {
    "punishment": ["overwhelm"],
    "torturous": ["overwhelm"],
    "teasing": ["starve", "ache"],
    "intense": ["control"]
  },

  // How her mood leans on each purpose, and on games, when she chooses (a multiplier, scaled by how strongly she feels it).
  "moodLenses": {
    "Cruel": { "overwhelm": 1.7, "starve": 0.8, "ache": 0.7 },
    "Relentless": { "control": 1.5, "starve": 0.6 },
    "Edgy": { "control": 1.6, "ache": 1.1 },
    "Teasing": { "starve": 1.7, "ache": 1.3, "overwhelm": 0.6 },
    "Playful": { "game": 1.9, "overwhelm": 0.7 },
    "Neutral": { "ache": 1.2 }
  }
}
